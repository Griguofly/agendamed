# Copiá este archivo como ".env" y completá los valores. El archivo ".env" NO se sube a GitHub.

# Clave para firmar las sesiones. Usá un texto largo y aleatorio.
# Para generar una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Base de datos. Vacío = SQLite local (archivo en la carpeta instance/).
# En Render se completa con la "Internal Database URL" de PostgreSQL.
DATABASE_URL=

# Usuario administrativo que se crea al iniciar (si ambos están completos).
ADMIN_EMAIL=admin@agendamed.com
ADMIN_PASSWORD=cambiar-esta-clave

# 1 en producción con HTTPS (Render) para que la cookie de sesión solo viaje por HTTPS.
COOKIE_SECURE=0

# 1 para modo debug en desarrollo local. Nunca en producción.
FLASK_DEBUG=0